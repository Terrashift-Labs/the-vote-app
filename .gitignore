# ============================================================
# TheVoteApp — .gitignore
# ============================================================

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
keystore.properties
google-services.json
GoogleService-Info.plist

# ============================================================
# Android
# ============================================================
android/.gradle/
android/local.properties
android/build/
android/app/build/
android/**/*.apk
android/**/*.aab
android/**/*.ap_
android/**/*.dex
android/captures/
android/.idea/
android/*.iml

# ============================================================
# iOS
# ============================================================
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/Pods/
ios/.build/
ios/Package.resolved
ios/**/*.ipa
ios/**/*.dSYM.zip
ios/**/*.dSYM

# ============================================================
# Node.js / Backend / Blockchain
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
dist/
build/
*.tsbuildinfo

# Hardhat
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
blockchain/deployments/localhost/

# ============================================================
# macOS
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ============================================================
# IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# Testing / Coverage
# ============================================================
coverage/
.nyc_output/
test-results/
*.lcov

# ============================================================
# Logs
# ============================================================
logs/
*.log
blockchain/coverage.json
