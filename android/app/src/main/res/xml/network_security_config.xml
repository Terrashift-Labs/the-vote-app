<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: pin to backend certificate -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.TheVoteApp.org</domain>
        <pin-set expiration="2027-01-01">
            <!-- Replace with actual SPKI fingerprint of your TLS certificate -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <!-- Backup pin -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
    </domain-config>

    <!-- Development: allow cleartext to local emulator host -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
