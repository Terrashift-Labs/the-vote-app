##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh does
#       not find so, but you have some other POSIX shell available, most probably
#       you will want to use it by executing a different shell, or explicitly telling
#       the script to use it. For example:
#
#           $ bash /path/to/gradlew
#
#       Busybox and similar reduced shells will NOT work, because this script
#       requires all of these POSIX shell features:
#         * functions;
#         * expansions «$var», «${var}», «${var:-default}», «${var+SET}»,
#           «${var#pattern}», «${var%pattern}»;
#         * compound commands having a testable exit status, especially «case»;
#         * various built-in commands including «command», «set», and «ulimit».
#
#   Important for patching:
#
#   (1) This script targets any POSIX shell, so avoiding extensions provided
#       by Bash, Ksh, etc; in particular arrays.
#
#       Executing this script in Bash will cause those extensions to be used, which
#       will break the full resumability. Busybox and similar reduced shells will NOT
#       have this problem; you might want to test with one of those.
#
#   Important for "squirrel" and later distributions where GUI is usually turned off prior to calling this script, you might need to set the property org.gradle.java.home to use a valid Java home directory.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}	# leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}			# remove leading ...
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_JAR="$(ls -1 "$APP_HOME"/gradle/wrapper/gradle-wrapper.jar 2>/dev/null | head -1)"
CLASSPATH=$APP_JAR

# This is normally unused
if [ -z "$JAVA_HOME" ] ; then
    JAVA="java"
else
    JAVA="$JAVA_HOME/bin/java"
fi

# This is normally unused
JAVA_OPTS=""

# Collect all arguments for the java command; all of the options to gradlew will
# be passed to the Java process.

set -- \
        "-Dorg.gradle.appname=$APP_NAME" \
        "-Dorg.gradle.wrapper.properties=$APP_HOME/gradle/wrapper/gradle-wrapper.properties" \
        "-classpath" "$CLASSPATH" \
        "org.gradle.wrapper.GradleWrapperMain" \
        "$@"

# Use "xargs" to parse quoted args.
#
# With -n1 it outputs one arg per line, useful for seeing what would be passed:
#
#     xargs -n1 <<<"$ARGS"
#
# in order to be in the same order, we need only change IFS and use 'case' when
# the number of elements inside will expand.
#
# if you want to see what exactly gets passed, uncomment the line below.
#    echo "$@"

exec "$JAVA" "$@"
