{
  "name": "TheVoteApp-backend",
  "version": "1.0.0",
  "description": "TheVoteApp backend API — relay, ZK proving, and country configuration",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "deploy:prod": "npm run build && pm2 restart TheVoteApp-api || pm2 start dist/index.js --name TheVoteApp-api"
  },
  "dependencies": {
    "@helia/unixfs": "^8.0.7",
    "@simplewebauthn/server": "^14.0.2",
    "@simplewebauthn/types": "^12.0.0",
    "@zkpassport/sdk": "^0.17.1",
    "blockstore-core": "^7.0.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^14.4.0",
    "helia": "^7.1.12",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "js-yaml": "^5.4.2",
    "multer": "^2.4.0",
    "multiformats": "^14.0.5",
    "pdfkit": "^0.20.2",
    "prom-client": "^15.1.3",
    "snarkjs": "^0.7.4",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.1.1",
    "winston": "^3.13.0",
    "ws": "^8.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pdfkit": "^0.17.6",
    "@types/sinon": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mocha": "^12.0.2",
    "sinon": "^22.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=22"
  }
}
