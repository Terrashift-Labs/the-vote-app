# ============================================================
# TheVoteApp Backend — Environment Variables
# Copy to .env. NEVER commit .env.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Blockchain
RPC_URL=http://127.0.0.1:8545
VOTE_LEDGER_ADDRESS=0x_from_deploy_output
VOTER_REGISTRY_ADDRESS=0x_from_deploy_output
POLICY_REGISTRY_ADDRESS=0x_from_deploy_output
RELAY_PRIVATE_KEY=0x_relay_wallet_key

# ZK Proving
ZK_CIRCUIT_WASM_PATH=./circuits/eligibility.wasm
ZK_ZKEY_PATH=./circuits/eligibility.zkey

# Security — global burst backstop (Redis sliding-window is the primary limiter)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
# Per-route Redis sliding-window limits (requests per minute per IP)
VOTE_RATE_LIMIT=5
AUDIT_RATE_LIMIT=60
ADMIN_RATE_LIMIT=10
CORS_ORIGIN=https://app.TheVoteApp.org

# Redis — session store for horizontal scaling
REDIS_URL=redis://localhost:6379

# Identity adapters
IDENTITY_COMMITMENT_SALT=replace-with-random-32-byte-hex
# eIDAS (EU)
EIDAS_JWKS_URI=https://oidc.node.eidas.europa.eu/oidc/jwks
EIDAS_ISSUER=https://oidc.node.eidas.europa.eu
EIDAS_AUDIENCE=your-eidas-client-id
EIDAS_COUNTRY_CODES=DE,FR,ES,IT,NL,PL,SE,AT,BE,DK,FI,IE,PT
# Gov.UK One Login
GOVUK_OIDC_JWKS_URI=https://oidc.account.gov.uk/.well-known/jwks.json
GOVUK_OIDC_ISSUER=https://oidc.account.gov.uk
GOVUK_OIDC_CLIENT_ID=your-govuk-client-id

# Multi-region IPFS pinning (optional — falls back to local Helia if not set)
PINATA_JWT=
WEB3_STORAGE_TOKEN=
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=thevoteapp-ipfs

# Logging — never log vote content
LOG_LEVEL=info
LOG_VOTES=false
