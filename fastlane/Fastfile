fastlane_version "2.220.0"

# ── Android ────────────────────────────────────────────────────────────────────

platform :android do

  desc "Run unit tests"
  lane :test do
    gradle(project_dir: "android", task: "test")
  end

  desc "Build a signed release AAB and upload to Google Play internal track"
  lane :release do
    gradle(
      project_dir: "android",
      task:        "bundle",
      build_type:  "Release",
      properties: {
        "android.injected.signing.store.file"     => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias"      => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password"   => ENV["ANDROID_KEY_PASSWORD"],
      }
    )
    upload_to_play_store(
      track:       "internal",
      aab:         "android/app/build/outputs/bundle/release/app-release.aab",
      json_key:    ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      package_name: "com.TheVoteApp",
      release_status: "draft"
    )
  end

  desc "Promote internal → production after QA sign-off"
  lane :promote_to_production do
    upload_to_play_store(
      track:        "internal",
      track_promote_to: "production",
      json_key:     ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      package_name: "com.TheVoteApp"
    )
  end
end

# ── iOS ────────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Run unit tests on simulator"
  lane :test do
    run_tests(
      workspace:   "ios/TheVoteApp.xcworkspace",
      scheme:      "TheVoteApp",
      devices:     ["iPhone 16"],
      clean:       true
    )
  end

  desc "Sync signing certificates and provisioning profiles (match)"
  lane :sync_certificates do
    match(
      type:         "appstore",
      app_identifier: "com.TheVoteApp",
      git_url:      ENV["MATCH_GIT_URL"],
      readonly:     is_ci
    )
  end

  desc "Archive, export IPA, and upload to App Store Connect TestFlight"
  lane :release do
    sync_certificates
    increment_build_number(xcodeproj: "ios/TheVoteApp.xcodeproj")
    build_app(
      workspace:    "ios/TheVoteApp.xcworkspace",
      scheme:       "TheVoteApp",
      output_directory: "ios/build",
      export_method: "app-store",
      clean:        true
    )
    upload_to_testflight(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit the latest TestFlight build for App Store review"
  lane :submit_for_review do
    deliver(
      api_key_path:  ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      submit_for_review: true,
      automatic_release: false,
      force:         true,
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots/ios"
    )
  end
end
